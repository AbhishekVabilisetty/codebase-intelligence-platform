# Create backend/.env from this file and add your NVIDIA API key.
NVIDIA_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# OpenRouter is selected automatically when its key is set; otherwise Gemini is used.
# Optional provider and model overrides:
# NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# GEMINI_CHAT_MODEL=gemini-3.8-flash
# LLM_PROVIDER=gemini
# OPENROUTER_CHAT_MODEL=openrouter/free
# GEMINI_REQUEST_TIMEOUT_SECONDS=30
